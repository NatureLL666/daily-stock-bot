# Optional. An empty URL skips Discord. Never commit .env.
DISCORD_WEBHOOK_URL=

# Optional Telegram push. Start a private conversation with your bot first.
# Keep both values in .env or GitHub Actions secrets, never in source code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AAII public-page fallback when direct official requests are blocked.
# Uses your existing Firecrawl account quota; maxAge=0 fetches fresh raw HTML.
FIRECRAWL_API_KEY=

# Optional authorized NAAIM export, stored outside Git:
# CSV headers: data_date,release_date,value
# NAAIM_CSV_PATH=/absolute/path/to/authorized-weekly-export.csv
